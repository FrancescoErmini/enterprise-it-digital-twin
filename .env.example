# Enterprise IT Digital Twin - POC 01 configuration.
# Copy to .env and set OPENAI_API_KEY. Neo4j credentials are NOT configured here:
# they are generated locally on first start into the `secrets` volume (scripts/init_credentials.py).

# --- LLM (required for the IT Intelligence Agent and Text2Cypher) ---------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Data source ------------------------------------------------------------------------
# Only "synthetic" is implemented. "cartography" (live GCP ingestion) is documented in docs/architecture.md.
DATA_SOURCE_MODE=synthetic

# --- Neo4j ------------------------------------------------------------------------------
NEO4J_DATABASE=neo4j
# Dedicated user the API and agent connect as (every transaction runs in READ access mode).
NEO4J_READER_USER=twin_reader
# Server-side ceiling for any transaction (the API applies its own, lower, per-query timeout).
NEO4J_TRANSACTION_TIMEOUT=30s

# --- Query safety limits (digital-twin-api) --------------------------------------------
QUERY_TIMEOUT_SECONDS=10
QUERY_MAX_ROWS=500
QUERY_MAX_RESULT_BYTES=1000000
QUERY_MAX_CONCURRENCY=4

# --- Agent ceilings ---------------------------------------------------------------------
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOKENS=120000
AGENT_MAX_TOOL_RETRIES=2
TEXT2CYPHER_MAX_REPAIRS=2

# --- Local ports (always bound to 127.0.0.1) --------------------------------------------
API_PORT=8000
UI_PORT=8501
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

LOG_LEVEL=INFO
